# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# JWT auth (PRD stack)
JWT_SECRET=change-me-in-production

# Cloudflare R2 (S3-compatible API)
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_API_TOKEN=
R2_BUCKET_NAME=builder

# App-signed download links (separate from R2 presigned URLs)
SIGNED_URL_SECRET=change-me-in-production

# Welcome emails (Resend — https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=onboarding@yourdomain.com

# WhatsApp via Interakt.ai (https://app.interakt.ai/settings/developer-setting)
INTERAKT_API_KEY=
INTERAKT_WEBHOOK_SECRET=
INTERAKT_DEFAULT_COUNTRY_CODE=+91
# Public app URL for document links in WhatsApp (required in production)
APP_BASE_URL=https://your-app.vercel.app
# Secret for /api/bot/process-inbound (webhook worker)
INTERNAL_BOT_SECRET=
# Optional: fallback template if session text API unavailable
# INTERAKT_BOT_REPLY_TEMPLATE=your_utility_template_name
